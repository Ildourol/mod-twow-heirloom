###################################################################################################
# mod-twow-heirloom module configuration
#
# Turtle WoW Custom vMaNGOS (1.18.1 / 1.12.1)
###################################################################################################

[ModuleConf]

#
# Heirloom.Enable
#     Description: Enables or disables the mod-twow-heirloom module.
#     Default:     1 (Enabled)
#                  0 (Disabled)
#
Heirloom.Enable = 1

#
# Heirloom.Collection.Enable
#     Description: Enables the heirloom shops, account unlocks, and alt claims.
#                  Turning it off preserves existing unlocks and owned items.
#     Default:     1 (Enabled)
#                  0 (Disabled)
#
Heirloom.Collection.Enable = 1

#
# Heirloom.Collection.PerCharacterUnlocks
#     Description: Each character earns their own choices. Newly unlocked families
#                  join the account collection, and claims spend no choices.
#                  Set to 0 to count all unlocks against one account allowance.
#     Default:     1 (Enabled)
#
Heirloom.Collection.PerCharacterUnlocks = 1

#
# Heirloom.Collection.Mail.Enable
#     Description: Mail bound vouchers for new heirloom choices. Shop prices vary
#                  by item type. Set to 0 to spend the same earned
#                  allowances directly at the shop without waiting for letters.
#     Default:     1 (Enabled)
#
Heirloom.Collection.Mail.Enable = 1

#
# Heirloom.Collection.Armor.Level10 / Level20 / Level30 / Level40 / Level50 / Level55
# Heirloom.Collection.WeaponTokens.Level10 / Level20 / Level30 / Level40 / Level50 / Level55
#     Description: Additional permanent choices at each bracket.
#                  Unused armor choices and weapon tokens carry forward independently.
#                  Set a bracket to 0 to award none. Lowering a limit preserves
#                  existing unlocks. Level55 replaces the former Level60 keys.
#     Default:     8 armor choices and 6 weapon tokens by level 55.
#
Heirloom.Collection.Armor.Level10 = 1
Heirloom.Collection.Armor.Level20 = 2
Heirloom.Collection.Armor.Level30 = 1
Heirloom.Collection.Armor.Level40 = 2
Heirloom.Collection.Armor.Level50 = 1
Heirloom.Collection.Armor.Level55 = 1
Heirloom.Collection.WeaponTokens.Level10 = 2
Heirloom.Collection.WeaponTokens.Level20 = 1
Heirloom.Collection.WeaponTokens.Level30 = 1
Heirloom.Collection.WeaponTokens.Level40 = 1
Heirloom.Collection.WeaponTokens.Level50 = 1
Heirloom.Collection.WeaponTokens.Level55 = 0

# Each Curator's Token buys one ring or trinket.
Heirloom.Collection.AccessoryTokens.Level10 = 1
Heirloom.Collection.AccessoryTokens.Level20 = 1
Heirloom.Collection.AccessoryTokens.Level30 = 1
Heirloom.Collection.AccessoryTokens.Level40 = 1
Heirloom.Collection.AccessoryTokens.Level50 = 0
Heirloom.Collection.AccessoryTokens.Level55 = 0

#
# Heirloom.Scaling.Enable
#     Description: Updates owned catalog heirlooms to the character's capped-level template.
#                  When disabled, owned templates stay at their current tier. Curator claims
#                  still use the same capped-level template at the time of delivery.
#     Default:     1 (Enabled)
#                  0 (Disabled)
#
Heirloom.Scaling.Enable = 1

#
# Heirloom.Scaling.MaxLevel
#     Description: Highest template tier for scaling and curator previews and claims (range: 1-60).
#     Default:     60
#
Heirloom.Scaling.MaxLevel = 60

#
# Heirloom.BonusXP.Enable
#     Description: Enables bonus experience granted by equipped heirloom pieces.
#     Default:     1 (Enabled)
#                  0 (Disabled)
#
Heirloom.BonusXP.Enable = 1

#
# Heirloom.BonusXP.Rate
#     Description: Global multiplier applied to all heirloom experience bonuses (bounds: 0.0 to 10.0).
#     Default:     1.0
#
Heirloom.BonusXP.Rate = 1.0

#
# Heirloom.BonusXP.ShoulderPercent
#     Description: Bonus experience percentage granted by an equipped heirloom shoulder piece.
#     Default:     10.0 (10%)
#
Heirloom.BonusXP.ShoulderPercent = 10.0

#
# Heirloom.BonusXP.ChestPercent
#     Description: Bonus experience percentage granted by an equipped heirloom chest piece.
#     Default:     10.0 (10%)
#
Heirloom.BonusXP.ChestPercent = 10.0

#
# Heirloom.BonusXP.RingPercent
#     Description: Bonus experience percentage granted by each equipped heirloom ring.
#     Default:     5.0 (5% per ring)
#
Heirloom.BonusXP.RingPercent = 5.0

#
# Heirloom.Durability.Loss.Player
#     Description: Controls whether players suffer durability loss and repair costs on equipped heirlooms.
#                  0 = Disabled (heirlooms never lose durability and never require repair).
#                  1 = Enabled (heirlooms suffer normal combat wear and death penalties).
#                  Note: Maximum durability remains visible on the item tooltip regardless of this setting.
#     Default:     0 (Disabled - no durability loss)
#
Heirloom.Durability.Loss.Player = 0

#
# Heirloom.Durability.Loss.Bot
#     Description: Controls whether playerbots (e.g. TortoiseBots) suffer durability loss on equipped heirlooms.
#                  0 = Disabled (heirlooms never lose durability and never require repair).
#                  1 = Enabled (heirlooms suffer normal combat wear and death penalties).
#                  Note: Maximum durability remains visible on the item tooltip regardless of this setting.
#     Default:     0 (Disabled - no durability loss)
#
Heirloom.Durability.Loss.Bot = 0

#
# Heirloom.Tokens.Required.Player
#     Description: Controls whether players need tokens/vouchers to buy heirloom items
#                  (weapons, armor, and trinkets/rings).
#                  0 = Disabled (players do not need any tokens to buy heirlooms).
#                  1 = Enabled (players must spend the required tokens/vouchers).
#     Default:     1 (Enabled)
#
Heirloom.Tokens.Required.Player = 1

#
# Heirloom.Tokens.Required.Bot
#     Description: Controls whether playerbots (e.g. TortoiseBots) need tokens/vouchers to buy
#                  heirloom items (weapons, armor, and trinkets/rings).
#                  0 = Disabled (playerbots do not need any tokens to buy any weapons, armor, or trinkets/rings).
#                  1 = Enabled (playerbots must spend the required tokens/vouchers, just like players).
#     Default:     1 (Enabled)
#
Heirloom.Tokens.Required.Bot = 1

#
# Heirloom.ItemIds
#     Description: Optional comma-separated item IDs eligible for heirloom XP and durability.
#                  Catalog items and native account-bound items qualify
#                  automatically. Only module catalog families have scaling templates.
#     Default:     ""
#
Heirloom.ItemIds = ""

#
# Heirloom.Announce.Enable
#     Description: Sends a system notification to the player when heirloom bonus experience is awarded.
#     Default:     1 (Enabled)
#                  0 (Disabled)
#
Heirloom.Announce.Enable = 1

#
# Heirloom.Debug.Enable
#     Description: Enables diagnostic logging for module operations.
#     Default:     0 (Disabled)
#                  1 (Enabled)
#
Heirloom.Debug.Enable = 0

#
# Heirloom.Database.AutoImport
#     Description: Applies pending module world and character SQL if the core updater has
#                  not done so. Restart once after a fallback world import to load
#                  the new item templates and curator script bindings.
#     Default:     1 (Enabled)
#                  0 (Disabled)
#
Heirloom.Database.AutoImport = 1

#
# Heirloom.Database.SqlPath
#     Description: Directory containing the World install SQL. The Characters install SQL is
#                  loaded from the sibling character directory. Leave empty for auto-discovery.
#     Default:     ""
#
Heirloom.Database.SqlPath = ""
